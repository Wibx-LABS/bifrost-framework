#!/usr/bin/env node

/**
 * Bifrost Validator
 * Used in CI/CD pipelines to enforce framework standards
 */

const fs = require('fs');
const path = require('path');
const sm = require('../runtime/state-manager.js');

const args = process.argv.slice(2);
const command = args[0];
const target = args[1];

if (!command) {
    console.log('Uso: bifrost-validate <state|plan|i18n-parity|api-calls|standards|qa-report|merge-ready> [caminho]');
    process.exit(1);
}

const REPO_ROOT = path.resolve(__dirname, '..');

switch (command) {
    case 'state':
        validateState(target || '.bifrost/STATE.md');
        break;
    case 'plan':
        validatePlan(target || '.bifrost/PLAN.md');
        break;
    case 'api-calls':
        validateApiCalls();
        break;
    case 'i18n-parity':
        validateI18nParity(target || 'apps/account/src/assets/i18n');
        break;
    case 'standards':
        validateStandards();
        break;
    case 'qa-report':
        validateQaReport(target || '.bifrost/QA_REPORT.md');
        break;
    case 'merge-ready':
        validateMergeReady();
        break;
    default:
        console.error(`Comando de validação desconhecido: ${command}`);
        process.exit(1);
}

function validateState(filePath) {
    console.log(`[INFO] Validando estado: ${filePath}`);
    try {
        const state = sm.loadState(path.resolve(process.cwd(), filePath));
        console.log('[OK] Estado é válido.');
        console.log(`   Funcionalidade: ${state.feature}`);
        console.log(`   Status: ${state.status}`);
    } catch (err) {
        console.error(`[ERRO] Validação de estado falhou: ${err.message}`);
        process.exit(1);
    }
}

function validatePlan(filePath) {
    console.log(`[INFO] Validando plano: ${filePath}`);
    const fullPath = path.resolve(process.cwd(), filePath);
    if (!fs.existsSync(fullPath)) {
        console.error('[ERRO] PLAN.md não encontrado.');
        process.exit(1);
    }
    // Basic markdown validation
    const content = fs.readFileSync(fullPath, 'utf8');
    if (!content.includes('# PLAN') && !content.includes('## Task')) {
        console.error('[ERRO] Formato do PLAN.md inválido. Deve conter tarefas.');
        process.exit(1);
    }
    console.log('[OK] Plano é válido.');
}

function validateQaReport(filePath) {
    console.log(`[INFO] Validando relatório de QA: ${filePath}`);
    const fullPath = path.resolve(process.cwd(), filePath);
    if (!fs.existsSync(fullPath)) {
        console.error('[ERRO] QA_REPORT.md não encontrado.');
        process.exit(1);
    }
    const content = fs.readFileSync(fullPath, 'utf8');
    if (content.includes('FAIL') || content.includes('FAILED')) {
        console.error('[ERRO] Relatório de QA indica falhas.');
        process.exit(1);
    }
    console.log('[OK] Relatório de QA aprovado.');
}

function validateApiCalls() {
    // Honestidade > checkmark: NÃO imprimir OK falso. Verificação real exige o
    // grafo/API do repo (não implementado). SKIP explícito, nunca "[OK]" mentiroso.
    console.log('[SKIP] api-calls: verificação NÃO implementada (exige grafo/API do repo real).');
    console.log('       Nenhuma chamada foi verificada — a confirmação dos endpoints é manual (Backend, no handoff).');
}

function validateStandards() {
    console.log('[SKIP] standards: verificação NÃO implementada (lint real roda via ESLint no repo).');
    console.log('       Nenhum padrão foi verificado por este comando.');
}

// i18n-parity: os dicionários (en/es/pt-br) devem ter EXATAMENTE o mesmo key-set.
// Protege o MUST de i18n mecanicamente. Exit 1 nomeando cada key divergente.
function flattenKeys(obj, prefix) {
    const keys = [];
    for (const k of Object.keys(obj)) {
        const full = prefix ? `${prefix}.${k}` : k;
        const v = obj[k];
        if (v !== null && typeof v === 'object' && !Array.isArray(v)) {
            keys.push(...flattenKeys(v, full));
        } else {
            keys.push(full);
            if (typeof v === 'string' && v.trim() === '') {
                keys.push(`${full}<<EMPTY>>`);
            }
        }
    }
    return keys;
}

function validateI18nParity(dir) {
    const fullDir = path.resolve(process.cwd(), dir);
    console.log(`[INFO] Verificando paridade i18n em: ${fullDir}`);
    if (!fs.existsSync(fullDir)) {
        console.error(`[ERRO] Diretório i18n não encontrado: ${fullDir}`);
        process.exit(1);
    }
    const files = fs.readdirSync(fullDir).filter((f) => f.endsWith('.json'));
    if (files.length < 2) {
        console.error(`[ERRO] Paridade exige >=2 dicionários; encontrados: ${files.length ? files.join(', ') : 'nenhum'}`);
        process.exit(1);
    }
    const sets = {};
    for (const f of files) {
        let parsed;
        try {
            parsed = JSON.parse(fs.readFileSync(path.join(fullDir, f), 'utf8'));
        } catch (err) {
            console.error(`[ERRO] ${f}: JSON inválido — ${err.message}`);
            process.exit(1);
        }
        sets[f] = new Set(flattenKeys(parsed, ''));
    }
    const union = new Set();
    for (const f of files) for (const k of sets[f]) union.add(k);
    let failed = false;
    for (const f of files) {
        for (const k of union) {
            if (k.endsWith('<<EMPTY>>')) {
                if (sets[f].has(k)) {
                    console.error(`[ERRO] ${f}: key com valor VAZIO: ${k.replace('<<EMPTY>>', '')}`);
                    failed = true;
                }
                continue;
            }
            if (!sets[f].has(k)) {
                console.error(`[ERRO] ${f}: key AUSENTE: ${k}`);
                failed = true;
            }
        }
    }
    if (failed) {
        process.exit(1);
    }
    console.log(`[OK] Paridade i18n: ${files.length} dicionários, ${[...union].filter((k) => !k.endsWith('<<EMPTY>>')).length} keys idênticas, nenhuma vazia.`);
}

function validateMergeReady() {
    console.log('[INFO] Verificando se a funcionalidade está pronta para merge...');
    validateState('.bifrost/STATE.md');
    validateQaReport('.bifrost/QA_REPORT.md');
    console.log('[OK] A funcionalidade está pronta para merge.');
}
